{
  "name": "@doccop/storage-postgres",
  "version": "0.1.0-alpha.0",
  "description": "Postgres reference implementation of doccop store interfaces (Drizzle ORM)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./migrations": "./migrations/"
  },
  "files": ["dist", "migrations", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doccop-org/doccop.git",
    "directory": "packages/storage-postgres"
  },
  "dependencies": {
    "@doccop/core": "0.1.0-alpha.0",
    "@doccop/server": "0.1.0-alpha.0",
    "drizzle-orm": "0.36.4",
    "postgres": "3.4.5"
  }
}
