{
  "name": "@doccop/server",
  "version": "0.2.0",
  "description": "Fastify HTTP server for doccop — templates, snippets, document rendering",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fresteem/doccop.git",
    "directory": "packages/server"
  },
  "dependencies": {
    "@doccop/core": "0.2.0",
    "@fastify/multipart": "9.0.3",
    "fastify": "5.2.1",
    "zod": "3.24.1"
  }
}
